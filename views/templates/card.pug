div(class="bg-white rounded-xl shadow border border-gray-200 hover:shadow-lg transition-all duration-300 overflow-hidden flex flex-col md:flex-row mb-6")
    
    //- Lado Izquierdo: Imagen
    div(class="relative md:w-2/5 h-64 md:h-auto group cursor-pointer")
        a(href=`/propiedad/${propiedad.id}`)
            img(class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src=`/uploads/${propiedad.imagen}` alt=`imagen propiedad ${propiedad.titulo}`)
        
        //- Etiquetas sobre la imagen
        span(class="absolute top-3 left-3 bg-white text-gray-800 text-xs font-bold px-3 py-1.5 rounded-md shadow flex items-center gap-1")
            svg(class="w-3 h-3 text-yellow-500" fill="currentColor" viewBox="0 0 20 20")
                path(d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z")
            | DESTACADO
            
        button(class="absolute top-3 right-3 text-gray-100 hover:text-red-500 transition-colors drop-shadow-md")
            svg(class="w-7 h-7" fill="currentColor" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z")

    //- Lado Derecho: Información
    div(class="p-6 md:w-3/5 flex flex-col justify-between")
        div
            div(class="flex justify-between items-start mb-2")
                p(class="text-sm text-gray-500 font-medium") Bienes & R. (Agencia)
                
            //- Precio (Simulamos el precio y la administración como en la imagen)
            h3(class="text-2xl font-bold text-gray-900 mb-1")= propiedad.precio.nombre
            
            //- Ubicación y Título
            p(class="text-gray-600 text-sm mb-3")= `${propiedad.categoria.nombre} en ${propiedad.calle}`
            h4(class="text-lg font-semibold text-gray-800 mb-2 truncate")= propiedad.titulo
            
            //- Iconos de características
            div(class="flex items-center gap-4 text-gray-600 text-sm my-4")
                span(class="flex items-center gap-1 font-medium")
                    svg(class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6")
                    | #{propiedad.habitaciones} Habs.
                span(class="flex items-center gap-1 font-medium border-l border-gray-300 pl-4")
                    svg(class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z")
                    | #{propiedad.wc} Baños
                if propiedad.estacionamiento
                    span(class="flex items-center gap-1 font-medium border-l border-gray-300 pl-4")
                        svg(class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18")
                        | #{propiedad.estacionamiento} Estac.

            //- Descripción corta
            p(class="text-gray-600 text-sm line-clamp-2")= propiedad.descripcion

        //- Botones de acción
        div(class="flex flex-wrap gap-3 mt-6 pt-4 border-t border-gray-100")
            a(href=`/propiedad/${propiedad.id}` class="flex-1 text-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-4 rounded-lg transition-colors flex items-center justify-center gap-2")
                svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z")
                | Contactar
            a(href=`/propiedad/${propiedad.id}` class="flex-1 text-center border-2 border-blue-600 text-blue-600 hover:bg-blue-50 font-bold py-2.5 px-4 rounded-lg transition-colors flex items-center justify-center gap-2")
                | Ver Detalles