extends ../layout/app

block styles
    link(rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css")


block contenido

    //- pre= JSON.stringify(propiedad, undefined, 2)

    div(class="bg-gradient-to-br from-blue-50 to-white py-8")
        div(class="container mx-auto px-4")
            div(class="mb-8")
                a(href="/" class="inline-flex items-center text-blue-600 hover:text-blue-700 font-medium transition-colors duration-200")
                    svg(class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20")
                        path(d="M9.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L7.414 9H15a2 2 0 012 2v2a1 1 0 11-2 0v-2H7.414l2.293 2.293a1 1 0 010 1.414z")
                    Volver al inicio
                
                h1(id="titulo" class="text-4xl font-bold text-gray-900 mt-4 mb-2")= propiedad.titulo
                
                div(class="flex items-center gap-4 text-sm")
                    a(href="#" class="bg-blue-100 text-blue-700 px-3 py-1 rounded-full font-medium")
                        svg(class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20")
                            path(d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z")
                        = propiedad.categoria.nombre

        div(class="container mx-auto px-4")
            div(class="grid grid-cols-1 lg:grid-cols-3 gap-8")
                div(class="lg:col-span-2 space-y-6")
                    div(class="bg-white rounded-2xl shadow-lg overflow-hidden")
                        img(class="w-full h-96 object-cover" src=`/uploads/${propiedad.imagen}` alt=`imagen de la propiedad ${propiedad.titulo}`)

                    div(class="bg-white rounded-2xl shadow-lg p-8")
                        h2(class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2")
                            svg(class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20")
                                path(d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z")
                            Descripción de la Propiedad
                        p(class="text-gray-700 leading-relaxed text-lg")= propiedad.descripcion

                    div(class="bg-white rounded-2xl shadow-lg p-8")
                        h2(class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2")
                            svg(class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20")
                                path(d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2")
                            Características Principales
                        
                        div(class="grid grid-cols-1 md:grid-cols-2 gap-6")
                            div(class="flex items-center gap-3 p-4 bg-blue-50 rounded-lg")
                                svg(class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20")
                                    path(d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z")
                                div
                                    p(class="text-sm text-gray-600 font-medium") Habitaciones
                                    p(class="text-xl font-bold text-gray-900")= propiedad.habitaciones

                            div(class="flex items-center gap-3 p-4 bg-blue-50 rounded-lg")
                                svg(class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20")
                                    path(d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z")
                                    path(fill-rule="evenodd" d="M4 5a2 2 0 012-2 1 1 0 000 2H6a2 2 0 100 4h2a2 2 0 100-4h2a1 1 0 100-2 2 2 0 00-2 2v11a2 2 0 002 2h4a2 2 0 002-2V5a2 2 0 00-2-2H6a2 2 0 00-2 2v11z" clip-rule="evenodd")
                                div
                                    p(class="text-sm text-gray-600 font-medium") Baños
                                    p(class="text-xl font-bold text-gray-900")= propiedad.wc

                            if propiedad.estacionamiento
                                div(class="flex items-center gap-3 p-4 bg-blue-50 rounded-lg")
                                    svg(class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20")
                                        path(d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z")
                                        path(d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z")
                                    div
                                        p(class="text-sm text-gray-600 font-medium") Estacionamiento
                                        p(class="text-xl font-bold text-gray-900")= propiedad.estacionamiento

                            div(class="flex items-center gap-3 p-4 bg-green-50 rounded-lg")
                                svg(class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 20 20")
                                    path(d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z")
                                    path(fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd")
                                div
                                    p(class="text-sm text-gray-600 font-medium") Precio
                                    p(class="text-xl font-bold text-green-600")= propiedad.precio.nombre

                aside(class="lg:col-span-1")
                    div(class="bg-white rounded-2xl shadow-lg overflow-hidden sticky top-4")
                        div(class="bg-gradient-to-r from-blue-600 to-blue-700 p-6")
                            h3(class="text-white text-xl font-bold flex items-center gap-2")
                                svg(class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20")
                                    path(d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z")
                                Ubicación

                        div(class="p-6")
                            div(class="h-64 rounded-lg overflow-hidden mb-6" id="mapa")
                                p(id="lat" class="hidden")= propiedad.lat
                                p(id="lng" class="hidden")= propiedad.lng

                            div(class="space-y-4")
                                div(class="flex items-start gap-3")
                                    svg(class="w-5 h-5 text-blue-600 mt-1" fill="currentColor" viewBox="0 0 20 20")
                                        path(d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z")
                                        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z")
                                    div
                                        p(class="text-sm text-gray-600 font-medium") Dirección
                                        p(id="calle" class="text-gray-900 font-semibold")= propiedad.calle

                            if !esVendedor
                                div(class="border-t pt-6")
                                    h3(class="text-lg font-bold text-gray-900 mb-4") Contactar al Vendedor
                                    
                                    if enviado
                                        div(class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg")
                                            p(class="font-medium text-center") ¡Mensaje Enviado Correctamente!

                                    else if usuario
                                        if errores
                                            div(class="mb-4")
                                                each error in errores
                                                    div(class="bg-red-100 border border-red-400 text-red-700 px-3 py-2 rounded mb-2")
                                                        p(class="text-sm font-medium")= error.msg

                                        form(method="POST" class="space-y-4")
                                            input(type="hidden" name="_csrf" value= csrfToken)

                                            div
                                                label(for="mensaje" class="block text-sm font-medium text-gray-700 mb-2") Tu Mensaje
                                                textarea(id="mensaje" name="mensaje" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" placeholder="Escribe tu mensaje aquí..." )

                                            button(type="submit" class="w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-bold py-3 px-4 rounded-lg transition-all duration-200 transform hover:scale-105 shadow-md hover:shadow-lg")
                                                Enviar Mensaje

                                    else 
                                        div(class="text-center py-6")
                                            p(class="text-gray-600 mb-4") Para contactar al vendedor, necesitas una cuenta
                                            a(class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors duration-200" href="/auth/registro") Crear Cuenta Gratuita


block scripts
    script(src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js")
    script(src="/js/mostrarMapa.js")