extends ./layout/app

block styles
    link(rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css")

block subHeader 
    div(class="bg-blue-900/50 backdrop-blur-sm border-b border-blue-700/50 hidden lg:block")
            div(class="container mx-auto px-4")
                .flex.justify-between.items-center.py-4
                    nav(class="flex space-x-8")
                        a(href="/categorias/1" class="text-blue-100 hover:text-white font-medium transition-colors duration-200 flex items-center gap-2") 
                            | Casas
                        
                        a(href="/categorias/2" class="text-blue-100 hover:text-white font-medium transition-colors duration-200 flex items-center gap-2")
                            | Departamentos
                        
                        a(href="/categorias/3" class="text-blue-100 hover:text-white font-medium transition-colors duration-200 flex items-center gap-2")
                            | Bodegas
                        
                        a(href="/categorias/4" class="text-blue-100 hover:text-white font-medium transition-colors duration-200 flex items-center gap-2")
                            | Terrenos
                        
                        a(href="/categorias/5" class="text-blue-100 hover:text-white font-medium transition-colors duration-200 flex items-center gap-2")
                            | Cabañas

                    form(action="/buscador" method="POST" class="flex items-center space-x-3")
                        input(type="hidden" name="_csrf" value= csrfToken)
                        div(class="relative")
                            input(type="text" id="termino" name="termino" placeholder="Buscar propiedades..." class="bg-white/10 backdrop-blur-sm text-white placeholder-blue-200 border border-blue-600/50 rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition-all duration-200")
                            svg(class="absolute right-3 top-2.5 w-5 h-5 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
                        button(type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-semibold px-4 py-2 rounded-lg transition-all duration-200 shadow hover:shadow-md transform hover:scale-105") Buscar

block contenido

    //- Barra de Filtros Superior Tipo Portal
    div(class="bg-white border-b border-gray-200 py-3 shadow-sm sticky top-0 z-10 hidden md:block")
        div(class="container mx-auto px-4 flex items-center gap-2")
            select(id="categorias" class="bg-gray-50 border border-gray-300 text-gray-700 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-48 p-2.5")
                option(value="") Tipo de Propiedad
                each categoria in categorias
                    option(value=categoria.id)= categoria.nombre
            
            select(id="precios" class="bg-gray-50 border border-gray-300 text-gray-700 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-48 p-2.5")
                option(value="") Rango de Precio
                each precio in precios
                    option(value=precio.id)= precio.nombre
                    
            button(class="flex items-center gap-2 bg-gray-50 border border-gray-300 text-gray-700 hover:bg-gray-100 text-sm rounded-lg px-4 py-2.5 font-medium transition-colors")
                svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4")
                | Más filtros

    div(class="container mx-auto px-4 py-8")
        //- Encabezado de Resultados y Botón del Mapa
        div(class="flex flex-col md:flex-row justify-between items-end md:items-center mb-6 pb-4 border-b border-gray-200")
            div
                h1(class="text-2xl font-bold text-gray-900") Inmuebles Destacados
                p(class="text-sm text-gray-500 mt-1") Mostrando los resultados más recientes
            
            div(class="mt-4 md:mt-0 flex gap-3")
                button(class="flex items-center gap-2 border border-gray-300 rounded-lg px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50")
                    svg(class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12")
                    | Popularidad
                button(id="btn-toggle-map" class="flex items-center gap-2 border border-gray-300 rounded-lg px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50")
                    svg(class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7")
                    span#texto-btn-mapa Ver Mapa

        //- Contenedor del Mapa (Oculto por defecto)
        div(id="contenedor-mapa" class="hidden transition-all duration-500 mb-8")
            div(id="mapa-inicio" class="h-[400px] w-full rounded-xl shadow-inner border border-gray-200 z-0")

        //- Lista de Propiedades (En 1 sola columna para que sean horizontales)
        div(class="grid grid-cols-1 gap-6 max-w-5xl mx-auto")
            
            if casas.length
                h2(class="text-xl font-bold text-gray-800 mt-4 mb-2") Casas en Venta
                each propiedad in casas
                    include ./templates/card

            if departamentos.length
                h2(class="text-xl font-bold text-gray-800 mt-8 mb-2 border-t pt-8") Departamentos en Venta
                each propiedad in departamentos
                    include ./templates/card

block scripts
    script(src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js")
    script(src="/js/mapaInicio.js?v=1.0.2")