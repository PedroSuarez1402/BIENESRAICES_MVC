extends ./layout/app

block styles
    link(rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css")


block contenido
    div(class="py-8 bg-gradient-to-br from-blue-50 to-white")
        div(class="container mx-auto px-4")
            h1(class="text-center text-4xl font-bold text-gray-900 mb-8") Encuentra tu Propiedad Ideal

            div(class="bg-white rounded-2xl shadow-lg p-6 mb-8")
                h2(class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2")
                    svg(class="w-5 h-5 text-blue-600" fill="currentColor" viewBox="0 0 20 20")
                        path(d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z")
                    Filtrar Propiedades

                div(class="flex flex-col md:flex-row md:items-center gap-4")
                    div(class="flex-1")
                        label(for="categorias" class="block text-sm font-medium text-gray-700 mb-2") Categorías
                        select(id="categorias" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200")
                            option(value="") - Todas las categorías -
                            each categoria in categorias
                                option(value=categoria.id )= categoria.nombre

                    div(class="flex-1")
                        label(for="precios" class="block text-sm font-medium text-gray-700 mb-2") Rango de Precios
                        select(id="precios" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200")
                            option(value="") - Todos los precios -
                            each precio in precios
                                option(value=precio.id )= precio.nombre

        div(id="mapa-inicio" class="h-[400px] w-full rounded-2xl overflow-hidden shadow-xl mb-12")

        section(class="py-12")
            div(class="container mx-auto px-4")
                div(class="text-center mb-10")
                    h2(class="text-3xl font-bold text-gray-900 mb-2") Casas en Venta
                    p(class="text-gray-600") Descubre las mejores casas disponibles
                    div(class="w-24 h-1 bg-gradient-to-r from-blue-600 to-blue-700 mx-auto mt-4 rounded-full")

                div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8")
                    each propiedad in casas
                        div(class="fade-in")
                            include ./templates/card

        section(class="py-12 bg-gray-50")
            div(class="container mx-auto px-4")
                div(class="text-center mb-10")
                    h2(class="text-3xl font-bold text-gray-900 mb-2") Departamentos en Venta
                    p(class="text-gray-600") Encuentra el apartamento perfecto para ti
                    div(class="w-24 h-1 bg-gradient-to-r from-blue-600 to-blue-700 mx-auto mt-4 rounded-full")

                div(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8")
                    each propiedad in departamentos
                        div(class="fade-in")
                            include ./templates/card

block scripts
    script(src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js")
    script(src="/js/mapaInicio.js?v=1.0.1")