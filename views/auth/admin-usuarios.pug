extends ../layout/admin

block contenido 
    .py-10
        h1.text-4xl.my-10.font-extrabold.text-center Bienes
            span.font-normal Raices
        h2.text-center.text-2xl.font-extrabold= pagina

        if usuarios.length
            div(class="bg-white shadow rounded-lg overflow-hidden mt-10 max-w-5xl mx-auto")
                table(class="min-w-full divide-y divide-gray-200")
                    thead(class="bg-gray-50")
                        tr
                            th(class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider") Nombre
                            th(class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider") Email
                            th(class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider") Rol
                            th(class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider") Estado
                    tbody(class="bg-white divide-y divide-gray-200")
                        each user in usuarios
                            tr
                                td(class="px-6 py-4 whitespace-nowrap")
                                    div(class="text-sm font-medium text-gray-900")= user.nombre
                                td(class="px-6 py-4 whitespace-nowrap")
                                    div(class="text-sm text-gray-500")= user.email
                                td(class="px-6 py-4 whitespace-nowrap")
                                    span(class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-indigo-100 text-indigo-800")= user.rol.nombre
                                td(class="px-6 py-4 whitespace-nowrap text-sm text-gray-500")
                                    if user.confirmado
                                        span(class="text-green-600 font-bold") Confirmado
                                    else
                                        span(class="text-yellow-600 font-bold") Pendiente
        else 
            p(class="text-center mt-10") No hay usuarios registrados.