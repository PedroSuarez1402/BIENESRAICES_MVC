extends ../layout/admin

block contenido 
    .py-10
        h1.text-4xl.my-10.font-extrabold.text-center Bienes
            span.font-normal Raices
        h2.text-center.text-2xl.font-extrabold= pagina

        div(class="bg-white shadow py-8 px-4 rounded-lg max-w-2xl mx-auto md:px-10 mt-10")
            div(class="space-y-5")
                p(class="text-gray-600 font-bold") Nombre: 
                    span(class="text-black font-normal")= usuarioInfo.nombre
                p(class="text-gray-600 font-bold") Email: 
                    span(class="text-black font-normal")= usuarioInfo.email
                p(class="text-gray-600 font-bold") Rol del Sistema: 
                    span(class="inline-block bg-indigo-100 text-indigo-800 px-2 py-1 rounded text-sm font-bold")= usuarioInfo.rol.nombre
                
                div.pt-5
                    a(href="/mis-propiedades" class="w-full md:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-10 rounded cursor-pointer inline-block text-center") Volver a Propiedades