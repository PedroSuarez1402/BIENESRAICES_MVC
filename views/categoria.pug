extends ./layout/app

block subHeader 
    div(class="bg-blue-900/50 backdrop-blur-sm border-b border-blue-700/50 hidden lg:block")
            div(class="container mx-auto px-4")
                .flex.justify-between.items-center.py-4
                    nav(class="flex space-x-8")
                        a(href="/categorias/1" class="text-blue-100 hover:text-white font-medium transition-colors duration-200 flex items-center gap-2") 
                            | Casas
                        
                        a(href="/categorias/2" class="text-blue-100 hover:text-white font-medium transition-colors duration-200 flex items-center gap-2")
                            | Departamentos
                        
                        a(href="/categorias/3" class="text-blue-100 hover:text-white font-medium transition-colors duration-200 flex items-center gap-2")
                            | Bodegas
                        
                        a(href="/categorias/4" class="text-blue-100 hover:text-white font-medium transition-colors duration-200 flex items-center gap-2")
                            | Terrenos
                        
                        a(href="/categorias/5" class="text-blue-100 hover:text-white font-medium transition-colors duration-200 flex items-center gap-2")
                            | Cabañas

                    form(action="/buscador" method="POST" class="flex items-center space-x-3")
                        input(type="hidden" name="_csrf" value= csrfToken)
                        div(class="relative")
                            input(type="text" id="termino" name="termino" placeholder="Buscar propiedades..." class="bg-white/10 backdrop-blur-sm text-white placeholder-blue-200 border border-blue-600/50 rounded-lg px-4 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent transition-all duration-200")
                            svg(class="absolute right-3 top-2.5 w-5 h-5 text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
                        button(type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-semibold px-4 py-2 rounded-lg transition-all duration-200 shadow hover:shadow-md transform hover:scale-105") Buscar


block contenido
    section(class="py-5")
        h2(class="text-center text-4xl font-extrabold pt-10")= pagina

        if propiedades.length
            div(class="grid grid-cols-1 gap-6 max-w-5xl mx-auto")
                each propiedad in propiedades
                    include ./templates/card
        else 
            p(class="text-center text-gray-800 text-sm py-10") No Hay Resultados