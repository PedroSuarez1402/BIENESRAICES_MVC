{
  "name": "bienesraices_mvc",
  "version": "1.0.0",
  "description": "Proyecto de Node.js",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "server": "tsx watch --env-file=.env index.ts",
    "build": "tsc",
    "css": "postcss public/css/tailwind.css -o public/css/app.css --watch",
    "js": "webpack --watch",
    "dev": "concurrently \"npm run server\" \"npm run css\" \"npm run js\"",
    "db:importar": "tsx ./seed/seeder.ts -i",
    "db:eliminar": "tsx ./seed/seeder.ts -e"
  },
  "keywords": [
    "MVC",
    "Pug",
    "Tailwind",
    "MySQL",
    "Sequelize"
  ],
  "author": "Pedro Suarez",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.3.1",
    "dropzone": "^5.9.3",
    "express": "^5.2.1",
    "express-validator": "^6.14.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mysql2": "^3.18.0",
    "nodemailer": "^8.0.1",
    "pug": "^3.0.2",
    "sequelize": "^6.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pug": "^2.0.10",
    "autoprefixer": "^10.4.7",
    "concurrently": "^7.2.0",
    "postcss": "^8.4.13",
    "postcss-cli": "^9.1.0",
    "tailwindcss": "^3.0.24",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "webpack": "^5.72.1",
    "webpack-cli": "^4.9.2"
  }
}
